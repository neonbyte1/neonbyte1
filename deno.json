{
  "tasks": {
    "cards": "deno run --allow-net=api.github.com --allow-read=. --allow-write=. --allow-env=GITHUB_TOKEN tools/scripts/cards.ts",
    "terminal": "deno run --allow-read=. --allow-write=. tools/scripts/terminal.ts"
  },
  "lint": {
    "plugins": ["./tools/lint/deno_style.ts"],
    "exclude": ["node_modules/"]
  },
  "fmt": {
    "lineWidth": 120,
    "sortNamedImports": "maintain"
  }
}
